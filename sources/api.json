{
    "openflix_manifest":{
        "version":1,
        "manifest_version":1
    },
    "api":{
        "api":{
            "by":"https://simkl.com",
            "docs":"https://api.simkl.org/api-reference"
        },
        "translator":"https://api.simkl.com/{type}/{imdb}/?client_id={clientid}",
        "start_url":"https://data.simkl.in/discover/",
        "for":"recommendations and images",
        "structure":{
            "page":"page",
            "limit":"limit",
            "posters":"https://simkl.in/posters/{posterID}_m.jpg",
            "backdrops":"http://simkl.in/fanart/{backdropID}_medium.webp",
            "landscape_poster":"https://simkl.in/posters/{posterID}_w.jpg",
            "pages":{
                "movies/today/popular":"trending/today_100.json",
                "movies/month/popular":"trending/today_100.json",
                "//movies/genre":"https://api.simkl.com/{type}/genres/{genre}/?client_id={clientid}",
                "//movies/alltime/popular":"https://api.simkl.com/{type}/best/all?client_id={clientid}"
            },
            "response":{
                "backdropID":"fanart",
                "posterID":"poster",
                "status":"status",
                "release_date":"release_date",
                "plot":"overview",
                "genre_list":"genres",
                "length":"runtime",
                "trailer":"trailer",
                "id_list":"ids",
                "imdb":"imdb",
                "translator":{
                    "similar":"users_recommendations",
                    "similar_response":{
                        "id_list":"ids",
                        "id":"simkl"
                    }
                }
            }
        },
        "searchapi":{
            "start_url":"https://www.omdbapi.com/?s=",
            "for":"search and pages",
            "space_character":"+",
            "structure":{
                "response":{
                    "results":"Search",
                    "imdb":"imdbID",
                    "error_message":"Error",
                    "poster":"Poster",
                    "title":"Title",
                    "type":"Type",
                    "type_movie":"movie",
                    "type_series":"series"
                }               
            }
        },
        "other_apis":{
            "id_translator":{
                "clientid":"a59f019ec98329eff4db7f034d7efe32aaf476cbf6fdf9fdc8b670ce63bcf0b0"
            },
            "alltime_popular":{
                "for":"recommendations for feed",
                "structure":{
                    "response":{
                        "id":"simkl_id",
                        "id_list":"ids"
                    }
                }
            }
        }
    }
}